# Read by src/us_wildfires_big_data/config.py. All values are optional; these are the defaults.

# Data directory (raw/ and processed/ live inside it)
# DATA_DIR=./data
# Kaggle API credentials (Kaggle → Settings → API → Create New Token). Fill them in .env only
KAGGLE_USERNAME=
KAGGLE_KEY=
KAGGLE_DATASET=rtatman/188-million-us-wildfires
COUNTIES_URL=https://www2.census.gov/geo/tiger/GENZ2021/shp/cb_2021_us_county_20m.zip

# MongoDB
MONGO_URI=mongodb://localhost:27017
MONGO_DB=wildfires
MONGO_COLLECTION=fires
MONGO_BATCH_SIZE=5000

# Dask. DASK_SCHEDULER is set by docker-compose; when empty a local cluster is started with
# DASK_WORKERS workers (defaults to the number of logical processors of the machine)
# DASK_SCHEDULER=tcp://localhost:8786
# DASK_WORKERS=8
# Workers per dask-worker container (defaults to nproc / 2, so 2 containers = nproc workers)
# DASK_NWORKERS=4

# Spark. SPARK_MASTER=local[*] runs Spark in a single process; docker-compose sets it to the
# spark-master service (spark://spark-master:7077)
# SPARK_MASTER=local[*]
# SPARK_DRIVER_MEMORY=4g
# SPARK_EXECUTOR_MEMORY=2g
# Address the executors use to reach the driver (defaults to the driver's IP)
# SPARK_DRIVER_HOST=
# Number of spark-worker containers and the resources each one offers to the executors
# SPARK_WORKERS=2
# SPARK_WORKER_CORES=2
# SPARK_WORKER_MEMORY=3g
# MONGO_SPARK_CONNECTOR=org.mongodb.spark:mongo-spark-connector_2.13:11.1.0

# Spark aggregations: grid cell size in degrees and minimum z-score of a hotspot cell
# GRID_CELL_DEGREES=0.5
# HOTSPOT_MIN_ZSCORE=2
